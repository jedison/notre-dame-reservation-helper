{
  "manifest_version": 3,
  "name": "Notre-Dame Reservation Helper",
  "version": "0.7.23",
  "description": "Local helper for monitoring Notre-Dame de Paris reservation slots in an already-verified browser session, with diagnostics and local tests.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://resa.notredamedeparis.fr/*"
  ],
  "action": {
    "default_title": "Notre-Dame Reservation Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://resa.notredamedeparis.fr/*"
      ],
      "js": [
        "logic.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://resa.notredamedeparis.fr/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
